{
  "name": "meu-bolinho",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador de confeitaria infantil (4-8 anos) com a regra ZERO AUTO-COMPLETE.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "roteiro": "node scripts/roteiro.mjs",
    "e2e": "node tests/e2e/aceite.cjs",
    "e2e:fases": "node tests/e2e/fases.cjs",
    "e2e:mundo2": "node tests/e2e/mundo2.cjs",
    "desktop": "npm run build && electron . --no-sandbox",
    "desktop:pacote": "npm run build && electron-builder --publish never",
    "android:sync": "npm run build && cap sync android",
    "ios:sync": "npm run build && cap sync ios",
    "icones": "node scripts/icones.cjs",
    "e2e:desktop": "xvfb-run -a node tests/e2e/desktop.cjs || node tests/e2e/desktop.cjs"
  },
  "dependencies": {
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.10",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/cli": "7.6.10",
    "@capacitor/ios": "7.6.10",
    "@types/node": "^22.20.5",
    "electron": "37.10.3",
    "electron-builder": "26.18.1",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  },
  "main": "electron/main.cjs",
  "author": "Meu Bolinho",
  "build": {
    "appId": "app.meubolinho",
    "productName": "Meu Bolinho",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Meu Bolinho"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.kids-games"
    },
    "publish": null
  },
  "desktopName": "meu-bolinho.desktop"
}

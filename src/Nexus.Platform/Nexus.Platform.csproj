<Project Sdk="Microsoft.NET.Sdk">
  <!--
    System Abstraction Layer. The only assembly allowed to talk to Windows
    (Registry, WMI, Services, Processes, Performance Counters, Power, Task Scheduler).
    Everything above it depends on the interfaces in /Abstractions.
    Namespace is Nexus.Platform (not Nexus.System) to avoid shadowing the BCL "System" namespace.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Nexus.Platform</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Contracts\Nexus.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Nexus.Tests" />
  </ItemGroup>
</Project>

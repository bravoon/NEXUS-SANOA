<Window x:Class="Nexus.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS OPTIMIZER" Width="1280" Height="820" MinWidth="980" MinHeight="620"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <DockPanel Background="{StaticResource PanelBrush}">
            <StackPanel DockPanel.Dock="Top" Margin="18,20,18,24">
                <TextBlock Text="NEXUS" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="OPTIMIZER" FontSize="11" Style="{StaticResource Muted}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="18,12">
                <TextBlock Style="{StaticResource Muted}" Text="{Binding EngineStatus.Platform, StringFormat=Platform: {0}}" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding EngineStatus.EngineVersion, StringFormat=Engine {0}}" />
                <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource YellowBrush}" Text="SIMULATION MODE"
                           Visibility="{Binding EngineStatus.IsSimulated, Converter={StaticResource Visible}}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding Selected}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="18,10" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1F2633" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1A202A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Glyph}" Width="26" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Page -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20,12,8">
            <ContentControl Content="{Binding Selected.Page}" />
        </ScrollViewer>

        <!-- Live engine events -->
        <DockPanel Grid.Column="2" Background="{StaticResource PanelBrush}">
            <TextBlock DockPanel.Dock="Top" Text="Engine events" Style="{StaticResource H2}" Margin="14,20,14,8" />
            <ListBox ItemsSource="{Binding Events}" Margin="8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,3">
                            <TextBlock FontSize="11" Foreground="{StaticResource AccentBrush}">
                                <Run Text="{Binding Timestamp, StringFormat=HH:mm:ss, Mode=OneWay}" />
                                <Run Text="{Binding Type, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="12" Text="{Binding Message}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Status bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#0B0D11" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding Connected, Converter={StaticResource Tone}}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="NoWrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

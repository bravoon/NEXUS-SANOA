<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Desktop UI (WPF). A pure client of the engine API:
    it references ONLY Nexus.Contracts (data shapes) and Nexus.Ipc (the pipe client).
    It contains no registry, process, service, PowerShell, WMI or hardware code — enforced by ArchitectureTests.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Nexus.UI</RootNamespace>
    <AssemblyName>NexusOptimizer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Contracts\Nexus.Contracts.csproj" />
    <ProjectReference Include="..\Nexus.Ipc\Nexus.Ipc.csproj" />
  </ItemGroup>
</Project>

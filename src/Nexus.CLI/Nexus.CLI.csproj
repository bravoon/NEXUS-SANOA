<Project Sdk="Microsoft.NET.Sdk">
  <!--
    nexus.exe — command-line client AND engine host ("nexus serve" runs the IPC API used by the desktop UI).
    It uses exactly the same Application Services / Optimization Engine as the UI.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Nexus.CLI</RootNamespace>
    <AssemblyName>nexus</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Application\Nexus.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\config\**\*" LinkBase="config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

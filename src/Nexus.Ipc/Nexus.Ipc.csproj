    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Nexus.Ipc</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Contracts\Nexus.Contracts.csproj" />
  </ItemGroup>
</Project>
